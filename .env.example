# --- Core ---
NODE_ENV=development
PORT=3000

# --- PostgreSQL (15+) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/jsyxi
# Dedicated least-privilege role the app connects with (append-only tables are revoked from it)
DATABASE_APP_URL=postgres://jsyxi_app:change-me@localhost:5432/jsyxi

# --- Redis / BullMQ ---
REDIS_URL=redis://localhost:6379

# --- Shopify ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_orders,write_orders,read_fulfillments,write_fulfillments,read_locations,read_products
APP_URL=https://app.jsyxi.com
API_URL=https://api.jsyxi.com

# --- Crypto ---
# KMS-managed master key stand-in for local dev (envelope encryption of credentials, §5.7 control 1)
MASTER_KEY_HEX=
# Salt for salted-hash PII correlation (§5.7 control 4, ADD-24)
PII_HASH_SALT=

# --- Sessions (RW-04: 12h inactivity TTL) ---
SESSION_TTL_SECONDS=43200

# --- Internal service-to-service token (internal endpoints, e.g. access requests) ---
JSYXI_INTERNAL_TOKEN=

# --- Documents (§9.9.1, S-26) ---
OBJECT_STORE_DIR=./var/objects
DOCUMENT_SIGNING_SECRET=
