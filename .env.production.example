# Jsyxi Shipping — production environment for app.jsyxi.com
#
# Copy to .env.production, fill EVERY blank, then:
#   ENV_FILE=./.env.production SSH_USER=<login> SSH_KEY=./my-app-key.pem ./deploy/deploy.sh
#
# Lands at /srv/jsyxi-shipping/shared/.env, mode 600, owned by the jsyxi user.
# .env.production is gitignored — never commit a filled copy.

# --- Core ---
NODE_ENV=production
PORT=3000
# nginx is the only thing that should reach the process.
HOST=127.0.0.1

# --- PostgreSQL (AWS RDS, ap-south-1) ---
# DATABASE_URL is the MIGRATION OWNER — it needs DDL rights and is used only by
# node-pg-migrate during deploy.
DATABASE_URL=postgres://<owner_user>:<owner_password>@my-app-postgres.ctiwq4cm6blm.ap-south-1.rds.amazonaws.com:5432/jsyxi?sslmode=require
# DATABASE_APP_URL is what the running app connects as: the least-privilege
# jsyxi_app role with no UPDATE/DELETE on append-only tables (§6).
DATABASE_APP_URL=postgres://jsyxi_app:<app_password>@my-app-postgres.ctiwq4cm6blm.ap-south-1.rds.amazonaws.com:5432/jsyxi?sslmode=require

# --- Redis / BullMQ (local to the app host, loopback only) ---
REDIS_URL=redis://127.0.0.1:6379

# --- Shopify (Partner dashboard → your app → Client credentials) ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_orders,write_orders,read_fulfillments,write_fulfillments,read_locations,read_products
# Must match the Partner dashboard App URL exactly, no trailing slash.
APP_URL=https://app.jsyxi.com
API_URL=https://app.jsyxi.com

# --- Crypto ---
# 64 hex chars. Encrypts every stored Shopify token and courier credential
# (§5.7 control 1). Rotating or losing this makes stored credentials unreadable.
#   openssl rand -hex 32
MASTER_KEY_HEX=
# Salt for salted-hash PII correlation (§5.7 control 4, ADD-24). Also permanent:
# changing it breaks correlation of already-hashed records.
#   openssl rand -hex 16
PII_HASH_SALT=

# --- Sessions (RW-04: 12h inactivity TTL) ---
SESSION_TTL_SECONDS=43200

# --- Internal service-to-service token ---
#   openssl rand -hex 32
JSYXI_INTERNAL_TOKEN=

# --- Documents (§9.9.1, S-26) ---
# Inside the systemd unit's ReadWritePaths.
OBJECT_STORE_DIR=/srv/jsyxi-shipping/shared/objects
#   openssl rand -hex 32
DOCUMENT_SIGNING_SECRET=
